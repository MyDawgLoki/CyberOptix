<Window x:Class="CyberOptix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:CyberOptix.Pages"
        xmlns:ctl="clr-namespace:CyberOptix.Controls"
        Title="CyberOptix" Icon="Assets/CyberOptix.ico" Height="780" Width="1260" MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" Background="{DynamicResource Tint}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="19*" MinWidth="210" MaxWidth="320"/>
            <ColumnDefinition Width="81*"/>
        </Grid.ColumnDefinitions>

        <!-- The app's background picture (set in App Settings) -->
        <Image x:Name="imgBackdrop" Grid.ColumnSpan="2" Stretch="Uniform" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
        <ctl:LoopingVideo x:Name="bgVideo" Grid.ColumnSpan="2" Visibility="Collapsed"/>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarTint}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12,0,12,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- The brand label fills the width of the sidebar, so it grows and shrinks with the window. -->
                <Grid Margin="0,6,0,14">
                    <Image Source="Assets/CyberOptix-Brand-Label.png" Stretch="Uniform" StretchDirection="Both" MaxHeight="84" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="CyberOptix"/>
                </Grid>

                <StackPanel Grid.Row="1" WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton x:Name="navHome" Tag="Home" GroupName="Nav" IsChecked="True" Style="{StaticResource NavItem}" Checked="NavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Width="22"/>
                            <TextBlock Text="Home" FontWeight="Medium" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navOptimizer" Tag="Optimizer" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Width="22"/>
                            <TextBlock Text="Optimizer" FontWeight="Medium" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navTasks" Tag="Tasks" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" Width="22"/>
                            <TextBlock Text="Task Manager" FontWeight="Medium" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navDisplay" Tag="Display" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Width="22"/>
                            <TextBlock Text="Display" FontWeight="Medium" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navWidgets" Tag="Widgets" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" Width="22"/>
                            <TextBlock Text="Widgets" FontWeight="Medium" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navHardware" Tag="Hardware" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" Style="{StaticResource Icon}" Width="22"/>
                            <TextBlock Text="Hardware" FontWeight="Medium" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navDock" Tag="Dock" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}" Width="22"/>
                            <TextBlock Text="Dock" FontWeight="Medium" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>                    <RadioButton x:Name="navTaskbar" Tag="Taskbar" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90E;" Style="{StaticResource Icon}" Width="22"/>
                            <TextBlock Text="Taskbar" FontWeight="Medium" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navWindows" Tag="Windows" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80A;" Style="{StaticResource Icon}" Width="22"/>
                            <TextBlock Text="Window Manager" FontWeight="Medium" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="2" WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton x:Name="navSettings" Tag="Settings" GroupName="Nav" Style="{StaticResource NavItem}" Checked="NavChecked"
                                 ToolTip="Change how CyberOptix looks">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Width="22"/>
                            <TextBlock Text="App Settings" FontWeight="Medium" Margin="10,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <TextBlock Text="Running as administrator" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" Margin="12,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1" x:Name="PageHost">
                <!-- Optimizer -->
                <Grid x:Name="pgOptimizer" Margin="24,0,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="colGames" Width="290"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="panelGames" Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,8,16,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="txtSearch" Grid.Row="0" Tag="Search games" TextChanged="SearchChanged" Margin="0,0,0,10"/>

                            <StackPanel x:Name="panelGameButtons" Grid.Row="1" Margin="0,0,0,10">
                                <UniformGrid Columns="2">
                                    <Button x:Name="btnScanSteam" Content="Scan Steam" Margin="0,0,4,0" Padding="6,0" FontSize="12.5" Click="ScanSteamClicked"
                                            ToolTip="Finds the games installed in your Steam libraries and adds them to this list."/>
                                    <Button x:Name="btnAddGame" Content="Add Game" Margin="4,0,0,0" Padding="6,0" FontSize="12.5" Click="AddGameFolderClicked"
                                            ToolTip="Pick a game's install folder to add it to this list."/>
                                </UniformGrid>
                                <Button x:Name="btnRemoveGame" Content="Remove" Margin="0,8,0,0" Padding="6,0" FontSize="12.5" IsEnabled="False" Click="RemoveGameClicked"
                                        ToolTip="Takes the selected game out of this list. It does not delete the game."/>
                                <TextBlock x:Name="txtGameStatus" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Margin="2,8,2,0"
                                           Foreground="{DynamicResource TextDimBrush}"/>
                            </StackPanel>

                            <TextBlock x:Name="txtNoGames" Grid.Row="2" TextWrapping="Wrap" TextAlignment="Center" Margin="12,28,12,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextDimBrush}"
                                       Text="No games yet. Press Scan Steam to find the games you have installed, or Add Game to pick one yourself."/>
                            <ListBox x:Name="lstGames" Grid.Row="2" SelectionChanged="GameSelected">
                                <ListBox.ContextMenu>
                                    <ContextMenu Opened="GameMenuOpened">
                                        <MenuItem x:Name="menuRemoveGame" Header="Remove" Click="RemoveGameClicked"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" Foreground="{DynamicResource TextDimBrush}" Width="22"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="stkOptimizer" MaxWidth="720" HorizontalAlignment="Left" Margin="0,8,24,16">
                            <TextBlock Text="Optimizer" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Gaming and Universal each keep their own settings. Change them, then press that tab's Save button to store and apply them. A restore point is created first." Style="{StaticResource PageSub}"/>

                            <TextBlock Text="Windows tweaks" Style="{StaticResource GroupTitle}" Margin="4,0,0,10"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="chkUltimate" Content="Ultimate Performance power plan" Tag="Keeps the CPU at full speed instead of letting it idle down. Uses more power, makes more heat and louder fans. Off (the default) puts Windows on the Balanced plan." IsChecked="False" Checked="TweakChanged" Unchecked="TweakChanged"/>
                                    <StackPanel x:Name="panelDupPlans" Orientation="Horizontal" Margin="16,0,16,12" Visibility="Collapsed">
                                        <Button x:Name="btnDupPlans" Content="Remove duplicate power plans" Click="DupPlansClicked"/>
                                        <TextBlock x:Name="txtDupPlans" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="chkGameDvr" Content="Disable Game DVR" Tag="Turns off Windows background game recording, which costs a few frames per second." IsChecked="True" Checked="TweakChanged" Unchecked="TweakChanged"/>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="chkFso" Content="Disable fullscreen optimizations" Tag="Stops Windows treating fullscreen games like borderless windows, so they run in true exclusive fullscreen. Can lower input lag." IsChecked="True" Checked="TweakChanged" Unchecked="TweakChanged"/>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="chkHags" Content="Hardware-accelerated GPU scheduling" Tag="Lets the graphics card schedule its own work, which can lower latency. Needs a restart and a supported GPU and driver. Off turns it off." IsChecked="True" Checked="TweakChanged" Unchecked="TweakChanged"/>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="chkVisual" Content="Disable visual effects" Tag="Sets Windows to its Best performance look: no animations, fades or shadows. Switching this off later does not undo it. Use Restore original Windows settings." ToolTipService.ShowDuration="30000" IsChecked="True" Checked="TweakChanged" Unchecked="TweakChanged"/>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="chkSysMain" Content="Disable SysMain" Tag="Stops the SysMain (Superfetch) service from preloading apps into memory. Off turns the service back on." Checked="TweakChanged" Unchecked="TweakChanged"/>
                                    <Border Style="{StaticResource Divider}"/>
                                    <CheckBox x:Name="chkNagle" Content="Disable Nagle's algorithm" Tag="Sends small network packets and replies straight away instead of batching them, for lower latency. Switching this off later does not undo it. Use Restore original Windows settings." IsChecked="True" Checked="TweakChanged" Unchecked="TweakChanged"/>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="panelCatalog"/>

                            <TextBlock Text="Display color" Style="{StaticResource GroupTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <ctl:SettingRow Title="Brightness" Description="50% is neutral.">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="sldBrightness" Width="220" Minimum="0" Maximum="100" Value="50" ValueChanged="NvidiaChanged"/>
                                            <TextBlock Text="{Binding Value, ElementName=sldBrightness, StringFormat={}{0:N0}%}" Width="52" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource Divider}"/>
                                    <ctl:SettingRow Title="Contrast" Description="50% is neutral.">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="sldContrast" Width="220" Minimum="0" Maximum="100" Value="50" ValueChanged="NvidiaChanged"/>
                                            <TextBlock Text="{Binding Value, ElementName=sldContrast, StringFormat={}{0:N0}%}" Width="52" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource Divider}"/>
                                    <ctl:SettingRow Title="Gamma" Description="1.00 is neutral.">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="sldGamma" Width="220" Minimum="0.3" Maximum="2.8" Value="1.05" ValueChanged="NvidiaChanged"/>
                                            <TextBlock Text="{Binding Value, ElementName=sldGamma, StringFormat={}{0:N2}}" Width="52" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource Divider}"/>
                                    <ctl:SettingRow Title="Digital vibrance" Description="Color saturation, from the NVIDIA driver. 50% is the driver default.">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="sldVibrance" Width="220" Minimum="0" Maximum="100" Value="70" ValueChanged="NvidiaChanged"/>
                                            <TextBlock Text="{Binding Value, ElementName=sldVibrance, StringFormat={}{0:N0}%}" Width="52" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource Divider}"/>
                                    <ctl:SettingRow Title="Hue" Description="Rotates all colors around the color wheel, from the NVIDIA driver.">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="sldHue" Width="220" Minimum="0" Maximum="359" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="NvidiaChanged"/>
                                            <TextBlock Text="{Binding Value, ElementName=sldHue, StringFormat={}{0:N0}°}" Width="52" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Pressing Save applies these to your main display. Set a different look per display on the Display page." Style="{StaticResource Note}"/>

                            <TextBlock Text="Graphics card" Style="{StaticResource GroupTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <ctl:SettingRow Title="Low latency mode">
                                        <ComboBox x:Name="cmbLatency" SelectedIndex="2" SelectionChanged="NvidiaChanged">
                                            <ComboBoxItem Content="Off"/>
                                            <ComboBoxItem Content="On"/>
                                            <ComboBoxItem Content="Ultra"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource Divider}"/>
                                    <ctl:SettingRow Title="Power management mode">
                                        <ComboBox x:Name="cmbPower" SelectedIndex="0" SelectionChanged="NvidiaChanged">
                                            <ComboBoxItem Content="Prefer Maximum Performance"/>
                                            <ComboBoxItem Content="Adaptive"/>
                                            <ComboBoxItem Content="Optimal Power"/>
                                        </ComboBox>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource Divider}"/>
                                    <ctl:SettingRow Title="Max frame rate" Description="0 means unlimited.">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider x:Name="sldMaxFps" Width="220" Minimum="0" Maximum="360" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="NvidiaChanged"/>
                                            <TextBlock Text="{Binding Value, ElementName=sldMaxFps, StringFormat=N0}" Width="52" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ctl:SettingRow>
                                    <Border Style="{StaticResource Divider}"/>
                                    <ctl:SettingRow Title="Video image, video color and desktop size" Description="Edge enhancement, noise reduction, RTX video enhancement and desktop resizing can only be changed in the NVIDIA Control Panel.">
                                        <Button Content="Open NVIDIA Control Panel" Click="OpenNvidiaClicked"/>
                                    </ctl:SettingRow>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Low latency, power management and max frame rate are saved to the profile only. The graphics driver does not let other programs set them." Style="{StaticResource Note}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,24,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="14,0" Height="44" HorizontalAlignment="Left" MinWidth="320">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="dotStatus" Width="8" Height="8" Fill="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="txtStatus" Text="Ready" Foreground="{DynamicResource TextDimBrush}" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="btnSaveGaming" Grid.Column="1" Content="Save Gaming profile" Style="{StaticResource PrimaryButton}"
                                Height="44" Padding="22,0" Click="SaveClicked"/>
                        <Button x:Name="btnSaveGeneral" Grid.Column="1" Content="Save Universal profile" Style="{StaticResource PrimaryButton}"
                                Height="44" Padding="22,0" Click="SaveClicked" Visibility="Collapsed"/>
                    </Grid>
                </Grid>

                <pages:HomePage x:Name="pgHome"/>
                <pages:TaskManagerPage x:Name="pgTasks" Visibility="Collapsed"/>
                <pages:DisplayHub x:Name="pgDisplay" Visibility="Collapsed"/>
                <pages:WidgetsHub x:Name="pgWidgetsTab" Visibility="Collapsed"/>
                <pages:HardwarePage x:Name="pgHardware" Visibility="Collapsed"/>
                <pages:DockPage x:Name="pgDock" Visibility="Collapsed"/>
                <pages:TaskbarPage x:Name="pgTaskbar" Visibility="Collapsed"/>
                <pages:SettingsPage x:Name="pgSettings" Visibility="Collapsed"/>
                <pages:WindowManagerPage x:Name="pgWindows" Visibility="Collapsed"/>
            </Grid>

            <!-- Gaming / Universal: centered at the very top of the Optimizer page -->
            <Border x:Name="modeSwitch" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="270" Height="42"
                    Background="#14000000" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="3"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <UniformGrid Columns="2">
                    <RadioButton x:Name="rbGaming" Content="Gaming" IsChecked="True" GroupName="Mode" Style="{StaticResource Segment}" Checked="ModeChanged"/>
                    <RadioButton x:Name="rbGeneral" Content="Universal" GroupName="Mode" Style="{StaticResource Segment}" Checked="ModeChanged"/>
                </UniformGrid>
            </Border>

            <!-- Window controls -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="MinClicked">
                    <TextBlock Text="&#xE921;" Style="{StaticResource Icon}" FontSize="10"/>
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="MaxClicked">
                    <TextBlock x:Name="glyphMax" Text="&#xE922;" Style="{StaticResource Icon}" FontSize="10"/>
                </Button>
                <Button Style="{StaticResource CloseButton}" Click="CloseClicked">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
