<UserControl x:Class="CyberOptix.Pages.HardwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CyberOptix.Controls"
             xmlns:pages="clr-namespace:CyberOptix.Pages"
             PreviewKeyDown="PagePreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="760" HorizontalAlignment="Left" Margin="24,8,24,40">
            <TextBlock Text="Hardware" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Your mouse, your keyboard, and the devices connected to this PC." Style="{StaticResource PageSub}"/>

            <Border Background="#14000000" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="rbMouse" Content="Mouse" IsChecked="True" GroupName="HwTab" Style="{StaticResource Segment}" Checked="TabChecked"/>
                    <RadioButton x:Name="rbKeyboard" Content="Keyboard" GroupName="HwTab" Style="{StaticResource Segment}" Checked="TabChecked"/>
                    <RadioButton x:Name="rbDevices" Content="Connect device" GroupName="HwTab" Style="{StaticResource Segment}" Checked="TabChecked"/>
                </StackPanel>
            </Border>

            <!-- ===================== Mouse ===================== -->
            <StackPanel x:Name="tabMouse">
                <TextBlock Text="Pointer" Style="{StaticResource GroupTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ctl:SettingRow Title="Pointer sensitivity" Description="How fast the pointer moves on screen. This is the Windows setting, 10 is the default.">
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="sldSpeed" Width="200" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SpeedChanged"/>
                                <TextBlock Text="{Binding Value, ElementName=sldSpeed, StringFormat={}{0:N0}}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ctl:SettingRow>
                        <Border Style="{StaticResource Divider}"/>
                        <CheckBox x:Name="chkPrecision" Content="Enhance pointer precision" Tag="Mouse acceleration. Turn it off for steady, predictable aiming." Click="PrecisionClicked"/>
                        <Border Style="{StaticResource Divider}"/>
                        <ctl:SettingRow Title="Scroll lines" Description="Lines moved for each notch of the scroll wheel.">
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="sldScroll" Width="200" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ScrollChanged"/>
                                <TextBlock Text="{Binding Value, ElementName=sldScroll, StringFormat={}{0:N0}}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ctl:SettingRow>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Note}" Margin="2,10,0,0"
                           Text="A mouse's own DPI (the number printed on its sensor settings) is stored inside the mouse and only the maker's software can change it. This page changes how Windows treats the mouse, which works for any mouse."/>

                <TextBlock Text="Cursor theme" Style="{StaticResource GroupTitle}" Margin="4,28,0,10"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ctl:SettingRow Title="Theme" Description="Every cursor theme installed on this PC.">
                            <ComboBox x:Name="cmbScheme" MinWidth="220"/>
                        </ctl:SettingRow>
                        <Border Style="{StaticResource Divider}"/>
                        <ctl:SettingRow Title="Cursor size" Description="1 is the smallest, 15 the largest.">
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="sldSize" Width="200" Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Text="{Binding Value, ElementName=sldSize, StringFormat={}{0:N0}}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ctl:SettingRow>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Apply theme and size" Style="{StaticResource PrimaryButton}" Click="ApplyCursorClicked"/>
                    <TextBlock x:Name="txtCursorStatus" Foreground="{DynamicResource TextDimBrush}" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="440"/>
                </StackPanel>

                <TextBlock Text="Glass Cursor" Style="{StaticResource GroupTitle}" Margin="4,28,0,10"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ctl:SettingRow Title="Glass Cursor" Description="A magnifying-lens pointer with Right Click To Zoom, built into CyberOptix. Its icon stays in the system tray while CyberOptix is running.">
                            <TextBlock x:Name="txtGlassState" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </ctl:SettingRow>
                        <Border Style="{StaticResource Divider}"/>
                        <StackPanel Orientation="Horizontal" Margin="16,14">
                            <Button x:Name="btnGlassStart" Content="Turn lens on" Style="{StaticResource PrimaryButton}" Click="GlassStartClicked"/>
                            <Button x:Name="btnGlassStop" Content="Turn lens off and restore pointer" Margin="10,0,0,0" Click="GlassStopClicked"/>
                            <Button Content="Restore normal pointer" Margin="10,0,0,0" Click="GlassRestoreClicked"/>
                        </StackPanel>
                        <TextBlock Margin="16,0,16,14" TextWrapping="Wrap" Foreground="{DynamicResource TextFaintBrush}" FontSize="12"
                                   Text="Its settings are right below, and also in the tray icon (right-click it and choose Glass Cursor settings). A change made in either place shows up in the other. Default keys: Ctrl + Alt + F free roam, C static center, X on/off, V and S right-click zoom, Z zoom on/off. Scroll the mouse wheel over the zoom window to change its zoom. Panic key: Ctrl + Alt + R brings the normal pointer back."/>
                        <TextBlock x:Name="txtGlassStatus" Margin="16,0,16,14" Foreground="{DynamicResource TextDimBrush}" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <pages:GlassCursorSettingsPanel x:Name="glassSettings" Margin="0,22,0,0"/>

                <pages:LightingCard x:Name="lightMouse" Group="mouse" Margin="0,28,0,0"/>
            </StackPanel>

            <!-- ===================== Keyboard ===================== -->
            <StackPanel x:Name="tabKeyboard" Visibility="Collapsed">
                <TextBlock Text="Hot-keys" Style="{StaticResource GroupTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel x:Name="panelHotkeys"/>
                        <TextBlock x:Name="txtNoHotkeys" Text="No hot-keys yet." Margin="16,14" Foreground="{DynamicResource TextDimBrush}"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Add a hot-key" Click="AddHotkeyClicked"/>
                    <TextBlock x:Name="txtHotkeyStatus" Foreground="{DynamicResource TextDimBrush}" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="480"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Note}" Margin="2,10,0,0"
                           Text="Click a key box, then press the combination. It needs Ctrl, Alt, Shift or Windows with another key, or an F key on its own. Backspace clears it, Esc cancels. A hot-key opens its program, file or website once each time you press it."/>

                <TextBlock Text="Remap keys" Style="{StaticResource GroupTitle}" Margin="4,28,0,10"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel x:Name="panelRemaps"/>
                        <TextBlock x:Name="txtNoRemaps" Text="No keys are remapped." Margin="16,14" Foreground="{DynamicResource TextDimBrush}"/>
                        <Border Style="{StaticResource Divider}"/>
                        <StackPanel Orientation="Horizontal" Margin="16,14">
                            <TextBlock Text="Make" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cmbFrom" MinWidth="150"/>
                            <TextBlock Text="act as" VerticalAlignment="Center" Margin="12,0,10,0"/>
                            <ComboBox x:Name="cmbTo" MinWidth="170"/>
                            <Button Content="Add" Margin="12,0,0,0" Click="AddRemapClicked"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Save remaps" Style="{StaticResource PrimaryButton}" Click="SaveRemapsClicked"/>
                    <Button Content="Remove all remaps" Margin="10,0,0,0" Click="ClearRemapsClicked"/>
                    <TextBlock x:Name="txtRemapStatus" Foreground="{DynamicResource TextDimBrush}" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="360"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Note}" Margin="2,10,0,0"
                           Text="Remaps are applied by Windows for every user and every keyboard. They take effect after restarting your PC. To undo them, remove them here and save."/>

                <pages:LightingCard x:Name="lightKeyboard" Group="keyboard" Margin="0,28,0,0"/>
            </StackPanel>

            <!-- ===================== Connect device ===================== -->
            <StackPanel x:Name="tabDevices" Visibility="Collapsed">
                <TextBlock Text="Add a device" Style="{StaticResource GroupTitle}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ctl:SettingRow Title="Bluetooth" Description="Put the device in pairing mode, then add it in Windows.">
                            <Button Content="Add Bluetooth device" Style="{StaticResource PrimaryButton}" Click="AddBluetoothClicked"/>
                        </ctl:SettingRow>
                        <Border Style="{StaticResource Divider}"/>
                        <ctl:SettingRow Title="Wired (USB)" Description="Just plug it in. Windows sets it up on its own and it appears in the list below.">
                            <Button Content="Look again" Click="RefreshDevicesClicked"/>
                        </ctl:SettingRow>
                        <Border Style="{StaticResource Divider}"/>
                        <ctl:SettingRow Title="Windows device settings" Description="Pair, rename or remove devices.">
                            <Button Content="Open Bluetooth and devices" Click="OpenDevicesClicked"/>
                        </ctl:SettingRow>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="titleConnected" Text="Connected now" Style="{StaticResource GroupTitle}" Margin="4,28,0,10"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="txtDevicesBusy" Text="Looking for devices..." Margin="16,14" Foreground="{DynamicResource TextDimBrush}"/>
                        <ItemsControl x:Name="lstDevices">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Margin="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="Medium"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="{DynamicResource TextDimBrush}" Margin="12,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Connection}" TextAlignment="Right" Foreground="{DynamicResource AccentBrush}"/>
                                        </Grid>
                                        <Border Style="{StaticResource Divider}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
