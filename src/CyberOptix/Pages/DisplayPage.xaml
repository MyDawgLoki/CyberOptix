<UserControl x:Class="CyberOptix.Pages.DisplayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CyberOptix.Controls"
             xmlns:pages="clr-namespace:CyberOptix.Pages"
             IsVisibleChanged="VisibilityChanged">
        <StackPanel Margin="0,0,0,0">
            <TextBlock Text="Screens" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Pick a display and give it its own wallpaper." Style="{StaticResource PageSub}"/>

            <TextBlock Text="Your displays" Style="{StaticResource GroupTitle}" Margin="4,0,0,10"/>
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <Border x:Name="mapHost" Height="260" CornerRadius="10" Background="#14000000" ClipToBounds="True" SizeChanged="MapSizeChanged">
                        <Canvas x:Name="mapCanvas"/>
                    </Border>
                    <TextBlock x:Name="txtMapHint" Style="{StaticResource Note}" Margin="2,10,0,0"
                               Text="Click a display to select it."/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="titleWallpaper" Text="Wallpaper" Style="{StaticResource GroupTitle}"/>
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <Border Height="200" CornerRadius="10" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                        <Border.Background>
                            <ImageBrush x:Name="previewBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                        <TextBlock x:Name="txtNoImage" Text="No image set on this display" Foreground="{DynamicResource TextFaintBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Choose image" Click="ChooseClicked"/>
                        <Button x:Name="btnApplyThis" Content="Set on this display" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="ApplyThisClicked"/>
                        <Button Content="Set on all displays" Margin="10,0,0,0" Click="ApplyAllClicked"/>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}" Margin="0,14,0,0"/>
                    <ctl:SettingRow Title="Fit" Description="Windows uses one fit mode for every display." Padding="2,10">
                        <ComboBox x:Name="cmbFit" SelectionChanged="FitChanged"/>
                    </ctl:SettingRow>
                </StackPanel>
            </Border>

            <pages:DisplayColorSection x:Name="colorSection"/>

            <TextBlock x:Name="txtStatus" Foreground="{DynamicResource TextDimBrush}" FontSize="13" Margin="4,14,0,0" TextWrapping="Wrap"/>
        </StackPanel>
</UserControl>
