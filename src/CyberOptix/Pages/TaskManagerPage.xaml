<UserControl x:Class="CyberOptix.Pages.TaskManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:CyberOptix.Pages"
             IsVisibleChanged="VisibilityChanged">
    <UserControl.Resources>
        <DataTemplate x:Key="ProcTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>
                <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding TitleSuffix, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}" FontSize="12"/>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding CpuText}" TextAlignment="Right" Foreground="{DynamicResource TextDimBrush}"/>
                <Border Grid.Column="2" Width="1" HorizontalAlignment="Left" Background="{DynamicResource StrokeBrush}" Margin="0,-4"/>
                <TextBlock Grid.Column="2" Text="{Binding MemText}" TextAlignment="Right" Foreground="{DynamicResource TextDimBrush}"/>
                <TextBlock Grid.Column="3" Text="{Binding Pid}" TextAlignment="Right" Foreground="{DynamicResource TextFaintBrush}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="24,8,24,0">
            <TextBlock Text="Task Manager" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="End programs that are stuck or heavy, and choose which apps start with Windows." Style="{StaticResource PageSub}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
            <Border Background="#14000000" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="3" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="rbTabProcs" Content="Processes" IsChecked="True" GroupName="TmTab" Style="{StaticResource Segment}" Checked="TabChanged"/>
                    <RadioButton x:Name="rbTabStartup" Content="Start-up apps" GroupName="TmTab" Style="{StaticResource Segment}" Checked="TabChanged"/>
                    <RadioButton x:Name="rbTabClean" Content="Free up resources" GroupName="TmTab" Style="{StaticResource Segment}" Checked="TabChanged"/>
                </StackPanel>
            </Border>
            <Button x:Name="btnNeverTop" Content="Never kill list" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Click="NeverOpenClicked"/>
            </StackPanel>
        </StackPanel>

    <ScrollViewer x:Name="scrollMain" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,0,24,40">
          <StackPanel x:Name="secProcs">
            <TextBlock Text="Performance" Style="{StaticResource SectionTitle}"/>
            <pages:MonitorPage x:Name="overview"/>
            <TextBlock Text="Processes" Style="{StaticResource SectionTitle}" Margin="0,36,0,0"/>
            <TextBlock Text="Apps are programs with a window you can see. Background processes run without one. Each process sits under Killable or Bloat. Windows, driver and security processes are left out so they can't be ended by accident." Style="{StaticResource PageSub}" Margin="0,4,0,16"/>

            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtProcSearch" Tag="Search processes" TextChanged="ProcSearchChanged"/>
                        <Border Grid.Column="1" Background="#14000000" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="3" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="rbSortCpu" Content="CPU" IsChecked="True" GroupName="ProcSort" Style="{StaticResource Segment}" Checked="ProcSortChanged"/>
                                <RadioButton x:Name="rbSortMem" Content="Memory" GroupName="ProcSort" Style="{StaticResource Segment}" Checked="ProcSortChanged"/>
                                <RadioButton x:Name="rbSortName" Content="Name" GroupName="ProcSort" Style="{StaticResource Segment}" Checked="ProcSortChanged"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="10,0,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource TextFaintBrush}"/>
                        <TextBlock Grid.Column="1" Text="CPU" FontSize="12" TextAlignment="Right" Foreground="{DynamicResource TextFaintBrush}"/>
                        <Border Grid.Column="2" Width="1" HorizontalAlignment="Left" Background="{DynamicResource StrokeBrush}" Margin="0,-4"/>
                        <TextBlock Grid.Column="2" Text="Memory" FontSize="12" TextAlignment="Right" Foreground="{DynamicResource TextFaintBrush}"/>
                        <TextBlock Grid.Column="3" Text="PID" FontSize="12" TextAlignment="Right" Foreground="{DynamicResource TextFaintBrush}"/>
                    </Grid>

                    <ListBox x:Name="lstProcs" Height="420" ItemTemplate="{StaticResource ProcTemplate}"
                             SelectionChanged="ProcSelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <!-- The divider between Apps and Background processes -->
                                        <StackPanel Margin="0,10,0,4">
                                            <TextBlock FontWeight="SemiBold" Margin="10,0,0,6" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Name.Label, Mode=OneWay}"/><Run Text="  " /><Run Text="{Binding ItemCount, Mode=OneWay}" Foreground="{DynamicResource TextFaintBrush}"/><Run Text="     "/><Run Text="{Binding Name.Hint, Mode=OneWay}" FontWeight="Normal" FontSize="12" Foreground="{DynamicResource TextFaintBrush}"/>
                                            </TextBlock>
                                            <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="10,0,10,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <Border x:Name="panelConfirm" Visibility="Collapsed" Margin="0,12,0,0" Padding="14,12" CornerRadius="10"
                            Background="#26F25F5C" BorderBrush="#66F25F5C" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="txtConfirm" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="btnConfirmEnd" Content="End task" Style="{StaticResource PrimaryButton}" Click="ConfirmEndClicked"/>
                                <Button Content="Cancel" Margin="10,0,0,0" Click="CancelEndClicked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="btnEndTask" Content="End task" Click="EndTaskClicked" IsEnabled="False"/>
                        <Button x:Name="btnEndTree" Content="End task and its child processes" Margin="10,0,0,0" Click="EndTreeClicked" IsEnabled="False"/>
                        <TextBlock x:Name="txtProcStatus" Foreground="{DynamicResource TextDimBrush}" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

          </StackPanel>

          <StackPanel x:Name="secStartup" Visibility="Collapsed" Width="760" HorizontalAlignment="Left">
            <TextBlock x:Name="txtStartupSummary" Style="{StaticResource PageSub}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="txtNoStartup" Text="No start-up apps were found." Margin="16,14" Foreground="{DynamicResource TextDimBrush}" Visibility="Collapsed"/>
                    <ItemsControl x:Name="lstStartup">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <CheckBox Content="{Binding Name}" Tag="{Binding Detail}" IsChecked="{Binding Enabled, Mode=OneWay}" Click="StartupClicked"/>
                                    <Border Style="{StaticResource Divider}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock x:Name="txtStartupStatus" Style="{StaticResource Note}" Text="Switching an app off stops it launching the next time you sign in. It does not close it now."/>

          </StackPanel>

          <StackPanel x:Name="secClean" Visibility="Collapsed" Width="760" HorizontalAlignment="Left">
            <StackPanel x:Name="cleanMain">
            <TextBlock Text="CyberOptix scans this PC and lists what is safe to stop, one item at a time. Nothing is switched on for you. Switch on what you want stopped, then press Run once. It runs one time and finishes. Nothing keeps running or comes back on its own; press it again when you want it again." Style="{StaticResource PageSub}" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="btnCleanScan" Content="Scan again" Click="CleanScanClicked"/>
                <Button Content="Untick all" Margin="10,0,0,0" Click="CleanUntickClicked"/>
                <Button x:Name="btnCleanRun" Content="Run once" Style="{StaticResource PrimaryButton}" Margin="24,0,0,0" Click="CleanRunClicked"/>
                <Button x:Name="btnCleanRestore" Content="Restore what was stopped" Margin="10,0,0,0" Click="CleanRestoreClicked"/>
            </StackPanel>
            <TextBlock x:Name="txtCleanScan" Foreground="{DynamicResource TextDimBrush}" FontSize="13" Margin="0,0,0,4" TextWrapping="Wrap"/>
            <TextBlock x:Name="txtCleanStatus" Foreground="{DynamicResource TextDimBrush}" FontSize="13" Margin="0,0,0,4" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource Note}" Margin="0,0,0,14" Text="Services are stopped and set to Manual, never deleted or disabled, and their original settings are saved so Restore can put them back. Security software, graphics drivers, audio and core Windows services are never touched."/>
            <Border x:Name="panelCleanConfirm" Visibility="Collapsed" Margin="0,0,0,14" Padding="14,12" CornerRadius="10"
                    Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="txtCleanConfirm" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Stop them" Style="{StaticResource PrimaryButton}" Click="CleanConfirmClicked"/>
                        <Button Content="Cancel" Margin="10,0,0,0" Click="CleanCancelClicked"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel x:Name="panelClean"/>

            </StackPanel>

          <StackPanel x:Name="secNever" Visibility="Collapsed">
            <Button Content="Back to Free up resources" HorizontalAlignment="Left" Margin="0,0,0,14" Click="NeverBackClicked"/>
            <TextBlock Text="Never kill list" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Switch on any program that must never be stopped. It is hidden from Free up resources and skipped even if something tries to stop it. Only programs running right now are listed; ones you saved earlier stay at the top." Style="{StaticResource PageSub}" Margin="0,0,0,14"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtNeverSearch" Tag="Search running programs" TextChanged="NeverSearchChanged"/>
                <Button x:Name="btnNeverRefresh" Grid.Column="1" Content="Refresh" Margin="10,0,0,0" Click="NeverRefreshClicked"/>
            </Grid>
            <TextBlock x:Name="txtNeverStatus" Foreground="{DynamicResource TextDimBrush}" FontSize="13" Margin="4,0,0,10" TextWrapping="Wrap"/>
            <StackPanel x:Name="panelNever"/>
          </StackPanel>
          </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
