<UserControl x:Class="CyberOptix.Pages.DesktopClockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CyberOptix.Controls"
             xmlns:pages="clr-namespace:CyberOptix.Pages">
    <StackPanel Margin="0,44,0,0">
        <TextBlock Text="Desktop Clock" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="The time with the date under it, drawn right on your wallpaper. It has no window or frame, never blocks a click, and stays behind your apps." Style="{StaticResource PageSub}"/>

        <Border Style="{StaticResource Card}">
            <CheckBox x:Name="chkOn" Content="Show the desktop clock" Tag="Puts the clock on your wallpaper. Pick a theme and tune it below; every change shows straight away." Click="Changed"/>
        </Border>

        <StackPanel x:Name="panelAll">
            <TextBlock Text="Theme" Style="{StaticResource GroupTitle}" Margin="4,0,0,10"/>
            <Border Style="{StaticResource Card}" Padding="8">
                <WrapPanel x:Name="panelThemes"/>
            </Border>

            <TextBlock Text="Time and date" Style="{StaticResource GroupTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="chk24" Content="24-hour time" Tag="Show 13:05 instead of 1:05 PM." Click="Changed"/>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="chkAmPm" Content="Show AM / PM" Tag="Only for 12-hour time." Click="Changed"/>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="chkSeconds" Content="Show seconds" Tag="A small seconds counter next to the time." Click="Changed"/>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="chkWeather" Content="Weather icon on the left" Tag="A weather icon and the temperature on the clock's left. The icon follows the local weather (the city and units are the ones on the Widgets page); click it to open the weather forecast widget, and click it again to close it. It looks the weather up on the internet (Open-Meteo) every 20 minutes, only while this is on." Click="Changed"/>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="chkDate" Content="Show the date under the time" Tag="The date is written the way the chosen theme likes it." Click="Changed"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Look" Style="{StaticResource GroupTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ctl:SettingRow Title="Size" Description="Scales the whole clock.">
                        <Slider x:Name="sldScale" Width="220" Minimum="0.5" Maximum="2.5" ValueChanged="SliderChanged"/>
                    </ctl:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <ctl:SettingRow Title="Opacity" Description="Lower it to let the wallpaper show through.">
                        <Slider x:Name="sldOpacity" Width="220" Minimum="0.2" Maximum="1" ValueChanged="SliderChanged"/>
                    </ctl:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="chkGlow" Content="Soft shadow / glow" Tag="Keeps the clock readable on any wallpaper. The Neon theme glows in its own color." Click="Changed"/>
                    <Border Style="{StaticResource Divider}"/>
                    <ctl:SettingRow Title="Color" Description="Text color follows the app. Media cover takes the color of what is playing (your accent color until something plays).">
                        <ComboBox x:Name="cmbColor" Width="200" SelectionChanged="SelectionChanged">
                            <ComboBoxItem Content="App text color" Tag="Text"/>
                            <ComboBoxItem Content="Accent color" Tag="Accent"/>
                            <ComboBoxItem Content="Media cover color" Tag="Media"/>
                            <ComboBoxItem Content="Custom" Tag="Custom"/>
                        </ComboBox>
                    </ctl:SettingRow>
                    <StackPanel x:Name="panelCustom" Margin="4,6,0,6">
                        <ctl:ColorWheel x:Name="wheelClock" DefaultHex="#FFFFFF"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Position" Style="{StaticResource GroupTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Note}" Margin="16,12,16,8" Text="Drag the clock anywhere on your screens. It moves on your desktop when you let go."/>
                    <pages:ClockPlacementMap x:Name="map" Margin="12,0,12,12"/>
                    <Border Style="{StaticResource Divider}"/>
                    <ctl:SettingRow Title="Screen" Description="Which of your displays shows the clock.">
                        <ComboBox x:Name="cmbDisplay" Width="260" SelectionChanged="SelectionChanged"/>
                    </ctl:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <ctl:SettingRow Title="Place it" Description="Where on that screen it sits. Text lines up to match.">
                        <ComboBox x:Name="cmbAnchor" Width="200" SelectionChanged="SelectionChanged"/>
                    </ctl:SettingRow>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
