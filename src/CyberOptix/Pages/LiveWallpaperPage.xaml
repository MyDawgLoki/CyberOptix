<UserControl x:Class="CyberOptix.Pages.LiveWallpaperPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CyberOptix.Controls">
        <StackPanel Margin="0,44,0,0">
            <TextBlock Text="Live Wallpaper" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Play a video, GIF or web page behind your desktop icons. Hover a type to see how heavy it is." Style="{StaticResource PageSub}"/>

            <TextBlock Text="Type" Style="{StaticResource GroupTitle}" Margin="4,0,0,10"/>
            <Border Style="{StaticResource Card}" Padding="8">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="rbVideo" Content="Video (MP4)" GroupName="LiveKind" Style="{StaticResource Segment}"
                                 Checked="KindChanged" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="30000">
                        <RadioButton.ToolTip>
                            <StackPanel>
                                <TextBlock Text="Video: light" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" Margin="0,4,0,0"
                                           Text="Plays through the GPU's video decoder. Typically 1-3% CPU, about 100-250 MB of RAM and a few percent GPU at 1080p. 4K or very high bitrate files cost more. The best choice for a gaming PC."/>
                                <TextBlock Text="Typical estimates, not measurements of your PC." FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton x:Name="rbGif" Content="Animated GIF" GroupName="LiveKind" Style="{StaticResource Segment}"
                                 Checked="KindChanged" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="30000">
                        <RadioButton.ToolTip>
                            <StackPanel>
                                <TextBlock Text="Animated GIF: medium" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" Margin="0,4,0,0"
                                           Text="Shown by an embedded browser and kept as decoded frames in memory. Typically 2-6% CPU and about 150-300 MB of RAM, more for large or long GIFs. Less efficient than a video of the same loop, so prefer MP4 when you can."/>
                                <TextBlock Text="Typical estimates, not measurements of your PC." FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </RadioButton.ToolTip>
                    </RadioButton>
                    <RadioButton x:Name="rbWeb" Content="Web page" GroupName="LiveKind" Style="{StaticResource Segment}"
                                 Checked="KindChanged" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="30000">
                        <RadioButton.ToolTip>
                            <StackPanel>
                                <TextBlock Text="Web page: heaviest" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" Margin="0,4,0,0"
                                           Text="Runs a full embedded browser with several background processes. Typically 150-400 MB of RAM and 3-15% CPU, and WebGL or shader pages can use a lot of GPU. Choose it for interactive or generated wallpapers, not for the lowest overhead."/>
                                <TextBlock Text="Typical estimates, not measurements of your PC." FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </RadioButton.ToolTip>
                    </RadioButton>
                </UniformGrid>
            </Border>

            <TextBlock Text="Source" Style="{StaticResource GroupTitle}"/>
            <Border Style="{StaticResource Card}">
                <ctl:SettingRow x:Name="rowSource" Title="File">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="txtSource" Width="300" Tag="Choose a file" TextChanged="SourceChanged"/>
                        <Button Content="Browse" Margin="8,0,0,0" Click="BrowseClicked"/>
                    </StackPanel>
                </ctl:SettingRow>
            </Border>

            <TextBlock Text="Behavior" Style="{StaticResource GroupTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="chkMute" Content="Mute audio" Tag="Takes effect the next time you start the wallpaper." Click="OptionChanged"/>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="chkPauseFs" Content="Pause while a game or fullscreen app is open" Tag="Frees the GPU and CPU for your game. Resumes when you leave it." Click="OptionChanged"/>
                    <Border Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="chkPauseMax" Content="Also pause when any window is maximized" Tag="Saves more power. The wallpaper is hidden behind maximized windows anyway." Click="OptionChanged"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button x:Name="btnStart" Content="Start live wallpaper" Style="{StaticResource PrimaryButton}" Click="StartClicked"/>
                <Button x:Name="btnStop" Content="Stop" Margin="10,0,0,0" Click="StopClicked"/>
                <TextBlock x:Name="txtStatus" Foreground="{DynamicResource TextDimBrush}" FontSize="13" VerticalAlignment="Center"
                           Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="420"/>
            </StackPanel>
        </StackPanel>
</UserControl>
