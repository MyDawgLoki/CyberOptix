<UserControl x:Class="CyberOptix.Pages.WallpaperPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CyberOptix.Controls">
    <StackPanel Margin="0,44,0,0">
        <TextBlock Text="Wallpaper slideshow" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Rotate through a folder of images on all displays. It runs while CyberOptix is open." Style="{StaticResource PageSub}"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <ctl:SettingRow Title="Folder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtFolder" Text="No folder selected" Foreground="{DynamicResource TextDimBrush}"
                                   VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                        <Button Content="Choose folder" Click="ChooseFolderClicked"/>
                    </StackPanel>
                </ctl:SettingRow>
                <Border Style="{StaticResource Divider}"/>
                <ctl:SettingRow Title="Change every">
                    <ComboBox x:Name="cmbInterval" SelectedIndex="2">
                        <ComboBoxItem Content="1 minute"/>
                        <ComboBoxItem Content="5 minutes"/>
                        <ComboBoxItem Content="10 minutes"/>
                        <ComboBoxItem Content="30 minutes"/>
                        <ComboBoxItem Content="60 minutes"/>
                    </ComboBox>
                </ctl:SettingRow>
                <Border Style="{StaticResource Divider}"/>
                <CheckBox x:Name="chkShuffle" Content="Shuffle" IsChecked="True"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button x:Name="btnSlideshow" Content="Start slideshow" Style="{StaticResource PrimaryButton}" Click="SlideshowClicked"/>
            <TextBlock x:Name="txtStatus" Foreground="{DynamicResource TextDimBrush}" FontSize="13" VerticalAlignment="Center"
                       Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="460"/>
        </StackPanel>
    </StackPanel>
</UserControl>
