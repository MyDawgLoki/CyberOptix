<UserControl x:Class="CyberOptix.Pages.AiAgentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CyberOptix.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="760" HorizontalAlignment="Left" Margin="24,0,24,40">
            <TextBlock Text="AI Agents" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="A Chat window for Grok, Perplexity, ChatGPT, Claude and Gemini, plus your own local LLM. You sign in to each one yourself, inside the window; CyberOptix never sees your password." Style="{StaticResource PageSub}"/>

            <TextBlock Text="Chat window" Style="{StaticResource GroupTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ctl:SettingRow Title="Show the Chat window" Description="A floating window you can type or talk to Grok, Perplexity, ChatGPT, Claude, Gemini or your own local LLM from, the same way an individual dock floats on your desktop.">
                        <CheckBox x:Name="chkEnabled" Click="EnabledClicked"/>
                    </ctl:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <ctl:SettingRow Title="Starts on" Description="Which tab the Chat window opens to.">
                        <ComboBox x:Name="cmbDefault" Width="160" SelectionChanged="DefaultPlatformChanged"/>
                    </ctl:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <ctl:SettingRow Title="Sits" Description="Stay on top keeps it in front. Fall behind (the default) lets windows cover it: move the pointer onto it to bring it forward. Stick behind covers it the same way, but only the Start menu brings it forward.">
                        <ComboBox x:Name="cmbLayer" Width="215" SelectionChanged="LayerChanged"/>
                    </ctl:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <StackPanel Orientation="Horizontal" Margin="16,14">
                        <Button Content="Open the Chat window now" Style="{StaticResource PrimaryButton}" Click="OpenClicked"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Platforms" Style="{StaticResource GroupTitle}" Margin="4,28,0,10"/>
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel x:Name="pnlPlatforms" Orientation="Horizontal"/>
            </Border>
            <TextBlock Style="{StaticResource Note}" Margin="2,10,0,0"
                       Text="Each tab shows that platform's own sign-in and chat page. Its microphone button works the same as it would in a browser, and the voice chat it transcribes shows up in that same page. CyberOptix stores no account passwords; it only remembers your sign-in session, the same way a browser does."/>

            <TextBlock Text="Local LLM" Style="{StaticResource GroupTitle}" Margin="4,28,0,10"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ctl:SettingRow Title="Address" Description="The web address of your local LLM's own page (for example a local Ollama or LM Studio web UI).">
                        <TextBox x:Name="txtLocalUrl" Width="300"/>
                    </ctl:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <ctl:SettingRow Title="API key" Description="Optional. Sent only to the address above, as a Bearer token, for a local server that asks for one. Saved encrypted; leave blank to keep what is already saved, or to use none.">
                        <PasswordBox x:Name="txtLocalKey" Width="300"/>
                    </ctl:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <StackPanel Orientation="Horizontal" Margin="16,14">
                        <Button Content="Save and approve" Style="{StaticResource PrimaryButton}" Click="SaveLocalClicked"/>
                        <Button Content="Forget" Margin="10,0,0,0" Click="ForgetLocalClicked"/>
                        <TextBlock x:Name="txtLocalStatus" Foreground="{DynamicResource TextDimBrush}" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="320"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
