<UserControl x:Class="CyberOptix.Pages.LightingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CyberOptix.Controls">
    <StackPanel>
        <TextBlock x:Name="titleLighting" Text="Lighting" Style="{StaticResource GroupTitle}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel x:Name="panelNone" Margin="16,14" Visibility="Collapsed">
                    <TextBlock x:Name="txtNone" TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Look again" Click="RefreshClicked"/>
                        <Button Content="Open Windows lighting settings" Margin="10,0,0,0" Click="OpenSettingsClicked"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="panelControls">
                    <ctl:SettingRow x:Name="rowDevices" Title="Devices">
                        <TextBlock x:Name="txtDevices" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Right" Foreground="{DynamicResource TextDimBrush}"/>
                    </ctl:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <ctl:SettingRow Title="Effect">
                        <ComboBox x:Name="cmbEffect" MinWidth="170" SelectionChanged="Changed"/>
                    </ctl:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <ctl:SettingRow x:Name="rowColor" Title="Color" Description="Used by Static, Breathing and Pulse.">
                        <StackPanel Orientation="Horizontal">
                            <WrapPanel x:Name="panelSwatches" MaxWidth="300" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtHex" Width="86" MaxLength="9" Margin="6,0,0,0" VerticalAlignment="Center" LostFocus="HexCommitted"/>
                        </StackPanel>
                    </ctl:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <ctl:SettingRow Title="Speed">
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="sldSpeed" Width="200" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Changed"/>
                            <TextBlock Text="{Binding Value, ElementName=sldSpeed, StringFormat={}{0:N0}}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ctl:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <ctl:SettingRow Title="Brightness">
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="sldBrightness" Width="200" Minimum="0" Maximum="100" ValueChanged="Changed"/>
                            <TextBlock Text="{Binding Value, ElementName=sldBrightness, StringFormat={}{0:N0}%}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ctl:SettingRow>
                </StackPanel>
            </StackPanel>
        </Border>
        <TextBlock x:Name="txtNote" Style="{StaticResource Note}" Margin="2,10,0,0"
                   Text="Works with devices that support Windows Dynamic Lighting. Effects are drawn by CyberOptix, so they run while it is open. If Windows shows another app's lighting, open Settings, Personalization, Dynamic Lighting and put CyberOptix first under background light control."/>
    </StackPanel>
</UserControl>
