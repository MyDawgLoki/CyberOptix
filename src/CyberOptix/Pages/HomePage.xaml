<UserControl x:Class="CyberOptix.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CyberOptix.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="24,8,24,24">
            <TextBlock Text="Home" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Quick choices to tune Windows, and to put things back. Each one tells you what it will do before it does it." Style="{StaticResource PageSub}"/>

            <TextBlock Text="Optimization" Style="{StaticResource GroupTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ctl:SettingRow Title="Turn off Windows bloatware" Description="Turns off the ads, tips and suggestions in Start and search, web results in Start, News and interests and Widgets, advertising ID, tailored experiences, activity history, optional diagnostic data, the telemetry service and peer-to-peer update sharing. A restore point is made first. You can undo it with Restore original Windows settings.">
                        <Button x:Name="btnBloat" Content="Turn off" Style="{StaticResource PrimaryButton}" Click="BloatClicked"/>
                    </ctl:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <ctl:SettingRow Title="Optimize display settings" Description="Turns off transparency and animation effects, and applies the display colors saved in your Gaming profile (digital vibrance, gamma, brightness and contrast) to your main display. A restore point is made first.">
                        <Button x:Name="btnDisplay" Content="Optimize" Style="{StaticResource PrimaryButton}" Click="DisplayClicked"/>
                    </ctl:SettingRow>
                </StackPanel>
            </Border>

            <TextBlock Text="Put things back" Style="{StaticResource GroupTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ctl:SettingRow Title="Restore my original Windows settings" Description="Puts Windows back the way it was before CyberOptix first ran: the tweaks you applied, services you stopped, display colors and rotation, key remaps, pointer speed, cursors and scrolling. You pick what to put back first. CyberOptix restarts afterward.">
                        <Button x:Name="btnRestore" Content="Restore" Click="RestoreClicked"/>
                    </ctl:SettingRow>
                    <Border Style="{StaticResource Divider}"/>
                    <ctl:SettingRow Title="Reset all settings to default" Description="Puts every CyberOptix setting back to its default (look, dock, widgets, clock and the rest). The programs, folders and games you added are kept, and Windows itself is not changed. CyberOptix restarts afterward.">
                        <Button x:Name="btnResetAll" Content="Reset all" Click="ResetAllClicked"/>
                    </ctl:SettingRow>
                </StackPanel>
            </Border>

            <TextBlock x:Name="txtStatus" Foreground="{DynamicResource TextDimBrush}" FontSize="13" Margin="4,16,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
