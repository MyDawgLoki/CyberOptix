<UserControl x:Class="CyberOptix.Pages.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CyberOptix.Controls"
             IsVisibleChanged="VisibilityChanged">
    <UserControl.Resources>
        <!-- One labelled value with a bar underneath -->
        <DataTemplate x:Key="MeterRowTemplate">
            <Grid Margin="16,11">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontWeight="Medium" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <ProgressBar Grid.Row="1" Style="{StaticResource Meter}" Value="{Binding Fraction}" Foreground="{Binding Fill}" Margin="0,8,0,0"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AppUsageTemplate">
            <Grid Margin="16,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding CpuText}" TextAlignment="Right" Foreground="{DynamicResource TextDimBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding GpuText}" TextAlignment="Right" Foreground="{DynamicResource TextDimBrush}"/>
                <Border Grid.Column="3" Width="1" HorizontalAlignment="Left" Background="{DynamicResource StrokeBrush}" Margin="0,-4"/>
                <TextBlock Grid.Column="3" Text="{Binding MemText}" TextAlignment="Right" Foreground="{DynamicResource TextDimBrush}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FanTemplate">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="150"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0">
                        <Run Text="{Binding RpmText, Mode=OneWay}"/>
                        <Run Text="·"/>
                        <Run Text="{Binding ModeText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Slider Width="200" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Percent, Mode=TwoWay}"
                            IsEnabled="{Binding Controllable}" ValueChanged="FanSliderChanged"/>
                    <Button Content="Auto" Margin="12,0,0,0" MinHeight="30" Padding="14,0" IsEnabled="{Binding IsManual}" Click="FanAutoClicked"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="0,4,0,0">
            <Grid>
                <TextBlock Text="Live temperatures, CPU and GPU graphs, memory and case fans. Updates once a second while this tab or a pop-out is open." Style="{StaticResource PageSub}" Margin="0,0,200,0" VerticalAlignment="Center"/>
                <Button x:Name="btnPopAll" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,0" Click="PopAllClicked"
                        ToolTip="Show temperatures, CPU and GPU on your desktop as their own widgets">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock x:Name="lblPopAll" Text="Pop out all"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border x:Name="noteSensors" Style="{StaticResource Card}" Padding="16,12" Margin="0,8,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="txtSensorNote" TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" FontSize="13"/>
                    <StackPanel x:Name="panelPawnIo" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                        <Button x:Name="btnInstallPawnIo" Content="Install the PawnIO sensor driver" Style="{StaticResource PrimaryButton}" Click="InstallPawnIoClicked"/>
                        <TextBlock x:Name="txtPawnIoStatus" Foreground="{DynamicResource TextDimBrush}" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Row 1: CPU beside Graphics, so both graphs are on screen together -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,8,0">
                    <Grid Margin="4,12,0,10">
                        <TextBlock Text="CPU" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Tag="cpu" HorizontalAlignment="Right" MinHeight="28" Padding="12,0" Click="PopClicked" ToolTip="Show this on your desktop as its own widget">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lblPopCpu" Text="Pop out" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="txtCpuName" Margin="16,12,16,0" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Usage over the last minute" FontSize="12" Foreground="{DynamicResource TextDimBrush}" Margin="16,2,16,0"/>
                            <ctl:LineGraph x:Name="graphCpu" Height="100" Margin="16,10,16,6"/>
                            <TextBlock x:Name="rowPawnIoLink" Margin="16,0,16,8" TextWrapping="Wrap" FontSize="13" Visibility="Collapsed">
                                <Run Text="CPU temperature isn't available. " Foreground="{DynamicResource TextDimBrush}"/>
                                <Hyperlink x:Name="linkPawnIo" Click="InstallPawnIoClicked" Foreground="{DynamicResource AccentBrush}"
                                           ToolTip="Installs the PawnIO sensor driver so CyberOptix can read your CPU temperature. You can uninstall it again in App Settings, under Restore and uninstall.">Install PawnIO</Hyperlink>
                            </TextBlock>
                            <ItemsControl x:Name="lstCpu" ItemTemplate="{StaticResource MeterRowTemplate}"/>
                            <Border Style="{StaticResource Divider}"/>
                            <TextBlock Text="Per core" Margin="16,12,16,8" Foreground="{DynamicResource TextDimBrush}"/>
                            <ItemsControl x:Name="lstCores" Margin="16,0,16,14">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- A horizontal meter turned on its side: it fills from the bottom up. -->
                                        <ProgressBar Style="{StaticResource Meter}" Width="46" Height="10" Margin="0,0,8,6"
                                                     ToolTip="{Binding Name}" Value="{Binding Load}" Foreground="{Binding Fill}">
                                            <ProgressBar.LayoutTransform>
                                                <RotateTransform Angle="-90"/>
                                            </ProgressBar.LayoutTransform>
                                        </ProgressBar>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Grid Margin="4,12,0,10">
                        <TextBlock Text="Graphics" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Tag="gpu" HorizontalAlignment="Right" MinHeight="28" Padding="12,0" Click="PopClicked" ToolTip="Show this on your desktop as its own widget">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lblPopGpu" Text="Pop out" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="txtNoGpu" Text="No graphics card sensors were found." Margin="16,14" Foreground="{DynamicResource TextDimBrush}" Visibility="Collapsed"/>
                            <TextBlock x:Name="txtGpuName" Margin="16,12,16,0" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Usage over the last minute" FontSize="12" Foreground="{DynamicResource TextDimBrush}" Margin="16,2,16,0"/>
                            <ctl:LineGraph x:Name="graphGpu" Height="100" Margin="16,10,16,6"/>
                            <ItemsControl x:Name="lstGpu" ItemTemplate="{StaticResource MeterRowTemplate}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Row 2: Temperatures beside Memory -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,8,0">
                    <Grid Margin="4,12,0,10">
                        <TextBlock Text="Temperatures" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Tag="temps" HorizontalAlignment="Right" MinHeight="28" Padding="12,0" Click="PopClicked" ToolTip="Show this on your desktop as its own widget">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock x:Name="lblPopTemps" Text="Pop out" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Style="{StaticResource Card}">
                        <ItemsControl x:Name="lstTemps" ItemTemplate="{StaticResource MeterRowTemplate}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Grid Margin="4,12,0,10">
                        <TextBlock Text="Memory" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" MinHeight="28"/>
                    </Grid>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <ItemsControl x:Name="lstMem" ItemTemplate="{StaticResource MeterRowTemplate}"/>
                            <Border Style="{StaticResource Divider}"/>
                            <ctl:SettingRow x:Name="rowRamSpeed" Title="RAM speed" Description="Loading...">
                                <TextBlock x:Name="txtRamSpeed" FontWeight="Medium"/>
                            </ctl:SettingRow>
                            <Border Style="{StaticResource Divider}"/>
                            <ItemsControl x:Name="lstRamModules" Margin="16,8,16,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextDimBrush}" Margin="0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="txtRamNote" Style="{StaticResource Note}"/>
                </StackPanel>
            </Grid>

            <!-- Apps -->
            <Grid Margin="4,20,0,10">
                <TextBlock Text="Apps" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Background="#14000000" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="3" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="rbAppCpu" Content="CPU" IsChecked="True" GroupName="AppSort" Style="{StaticResource Segment}" Checked="AppSortChanged"/>
                        <RadioButton x:Name="rbAppGpu" Content="GPU" GroupName="AppSort" Style="{StaticResource Segment}" Checked="AppSortChanged"/>
                        <RadioButton x:Name="rbAppMem" Content="RAM" GroupName="AppSort" Style="{StaticResource Segment}" Checked="AppSortChanged"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="0,4">
                <StackPanel>
                    <TextBlock x:Name="txtNoApps" Text="No apps with a window are currently running." Margin="16,10" Foreground="{DynamicResource TextDimBrush}" Visibility="Collapsed"/>
                    <Grid Margin="16,0,16,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource TextFaintBrush}"/>
                        <TextBlock Grid.Column="1" Text="CPU" FontSize="12" TextAlignment="Right" Foreground="{DynamicResource TextFaintBrush}"/>
                        <TextBlock Grid.Column="2" Text="GPU" FontSize="12" TextAlignment="Right" Foreground="{DynamicResource TextFaintBrush}"/>
                        <Border Grid.Column="3" Width="1" HorizontalAlignment="Left" Background="{DynamicResource StrokeBrush}" Margin="0,-4"/>
                        <TextBlock Grid.Column="3" Text="RAM" FontSize="12" TextAlignment="Right" Foreground="{DynamicResource TextFaintBrush}"/>
                    </Grid>
                    <ItemsControl x:Name="lstApps" ItemTemplate="{StaticResource AppUsageTemplate}" Margin="0,0,0,8"/>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Note}" Text="Apps are programs with a window you can see. For background processes and to end a task, open the Processes tab."/>

            <TextBlock Text="Case fans" Style="{StaticResource GroupTitle}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="txtNoFans" Margin="16,14" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" Visibility="Collapsed"
                               Text="No case fans were reported by your motherboard. Reading and controlling them usually needs administrator rights plus a sensor driver (PawnIO), and some boards keep fan control in firmware only. Your graphics card's fan speed is shown under Graphics."/>
                    <ItemsControl x:Name="lstFans" ItemTemplate="{StaticResource FanTemplate}"/>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Note}"
                       Text="Lowering a fan speed raises temperatures. Speeds you set here are handed back to automatic when CyberOptix closes."/>
    </StackPanel>
</UserControl>
