<UserControl x:Class="CyberOptix.Pages.DisplayColorSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CyberOptix.Controls">
    <StackPanel>
        <TextBlock x:Name="titleColor" Text="Color and orientation" Style="{StaticResource GroupTitle}" Margin="4,28,0,10"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <ctl:SettingRow Title="Orientation" Description="Rotate this display. Windows asks you to confirm, and goes back on its own if you don't.">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="cmbOrientation" MinWidth="170"/>
                        <Button x:Name="btnRotate" Content="Apply" Margin="10,0,0,0" Click="RotateClicked"/>
                    </StackPanel>
                </ctl:SettingRow>
                <Border x:Name="panelKeep" Visibility="Collapsed" Margin="16,0,16,12" Padding="14,12" CornerRadius="10"
                        Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="txtKeep" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Keep" Style="{StaticResource PrimaryButton}" Click="KeepClicked"/>
                            <Button Content="Revert" Margin="10,0,0,0" Click="RevertClicked"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Divider}"/>
                <ctl:SettingRow Title="Color channel" Description="Adjust all channels together, or tune red, green and blue separately.">
                    <ComboBox x:Name="cmbChannel" SelectionChanged="ChannelChanged">
                        <ComboBoxItem Content="All channels"/>
                        <ComboBoxItem Content="Red"/>
                        <ComboBoxItem Content="Green"/>
                        <ComboBoxItem Content="Blue"/>
                    </ComboBox>
                </ctl:SettingRow>
                <Border Style="{StaticResource Divider}"/>
                <ctl:SettingRow Title="Brightness">
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="sldBrightness" Width="220" Minimum="0" Maximum="100" ValueChanged="RampChanged"/>
                        <TextBlock Text="{Binding Value, ElementName=sldBrightness, StringFormat={}{0:N0}%}" Width="52" TextAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                </ctl:SettingRow>
                <Border Style="{StaticResource Divider}"/>
                <ctl:SettingRow Title="Contrast">
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="sldContrast" Width="220" Minimum="0" Maximum="100" ValueChanged="RampChanged"/>
                        <TextBlock Text="{Binding Value, ElementName=sldContrast, StringFormat={}{0:N0}%}" Width="52" TextAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                </ctl:SettingRow>
                <Border Style="{StaticResource Divider}"/>
                <ctl:SettingRow Title="Gamma">
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="sldGamma" Width="220" Minimum="0.3" Maximum="2.8" ValueChanged="RampChanged"/>
                        <TextBlock Text="{Binding Value, ElementName=sldGamma, StringFormat={}{0:N2}}" Width="52" TextAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                </ctl:SettingRow>
                <Border Style="{StaticResource Divider}"/>
                <ctl:SettingRow x:Name="rowVibrance" Title="Digital vibrance" Description="Color saturation, from the NVIDIA driver.">
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="sldVibrance" Width="220" Minimum="0" Maximum="100" ValueChanged="VibranceChanged"/>
                        <TextBlock Text="{Binding Value, ElementName=sldVibrance, StringFormat={}{0:N0}%}" Width="52" TextAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                </ctl:SettingRow>
                <Border Style="{StaticResource Divider}"/>
                <ctl:SettingRow x:Name="rowHue" Title="Hue" Description="Rotates all colors around the color wheel, from the NVIDIA driver.">
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="sldHue" Width="220" Minimum="0" Maximum="359" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="HueChanged"/>
                        <TextBlock Text="{Binding Value, ElementName=sldHue, StringFormat={}{0:N0}°}" Width="52" TextAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                </ctl:SettingRow>
                <Border Style="{StaticResource Divider}"/>
                <ctl:SettingRow x:Name="rowResetNv" Title="Reset vibrance and hue" Description="Puts digital vibrance and hue back to NVIDIA's defaults for this display. The NVIDIA driver keeps these (the same ones NVIDIA Control Panel shows), so they stay until you change them back.">
                    <Button x:Name="btnResetNv" Content="Reset to default" Click="ResetNvClicked"/>
                </ctl:SettingRow>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Reset this display's colors" Click="ResetClicked"/>
            <TextBlock x:Name="txtStatus" Foreground="{DynamicResource TextDimBrush}" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="480"/>
        </StackPanel>
        <TextBlock x:Name="txtNote" Style="{StaticResource Note}" Margin="2,10,0,0"
                   Text="Brightness, contrast and gamma work on any graphics card by adjusting the display's color curve. Some games reset it while they run; press a slider again to restore it."/>
    </StackPanel>
</UserControl>
