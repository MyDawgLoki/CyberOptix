<Window x:Class="CyberOptix.Widgets.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Agents"
        Width="420" Height="640" MinWidth="320" MinHeight="420"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Background="{DynamicResource Tint}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="10"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: the current platform's logo, the platform switcher (drag the rest of this row to move the window), and Close -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="pnlLogo" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <StackPanel x:Name="pnlTabs" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="btnClose" Grid.Column="2" Style="{StaticResource CloseButton}" Click="CloseClicked" Margin="0,0,4,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" FontSize="10"/>
                </Button>
            </Grid>

            <!-- The platform's own web page (added in code, like the live wallpaper's), or a short message when there is nothing to show yet -->
            <Grid x:Name="webHost" Grid.Row="1">
                <TextBlock x:Name="txtEmpty" TextWrapping="Wrap" Margin="24" TextAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextDimBrush}" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
